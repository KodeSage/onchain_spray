# ---------------------------------------------------------------------------
# Onchain Spray — environment
# Copy to .env.local for the app, and .env for Foundry scripts.
# ---------------------------------------------------------------------------

# --- Chain ------------------------------------------------------------------
# Chain 10143, Monad testnet. These have defaults in lib/rpc.ts; set them only
# to override.

# Dedicated RPC key. STRONGLY recommended for the event — Alchemy, QuickNode and
# thirdweb all offer a free Monad testnet key. When set, every client is
# assigned here and the public endpoints become failover only.
NEXT_PUBLIC_RPC_PRIMARY=
# Optional websocket for the dedicated key (used by /stage).
NEXT_PUBLIC_RPC_PRIMARY_WS=

# --- Contract ---------------------------------------------------------------
# Written by `npm run deploy`. Never hardcode this in source.
NEXT_PUBLIC_SPRAY_CONTRACT=

# --- Funding (server only — never exposed to the client) --------------------
# Private key of the master wallet that drips MON to burner wallets via
# /api/fund. MUST be funded in advance: faucet.monad.xyz drips small amounts
# per day and cannot fill this on the morning of the event.
# See README "Funding maths" for how much MON you actually need.
FUNDING_PRIVATE_KEY=

# MON sent to each new burner. Sized so one burner survives several hundred
# taps. See README for the arithmetic.
FUND_AMOUNT_MON=0.35

# Hard cap on total MON this process will ever dispense. Stops one person
# draining the master wallet.
FUND_TOTAL_CAP_MON=120

# --- Deploy (Foundry) -------------------------------------------------------
# Deployer key. Can be the same as FUNDING_PRIVATE_KEY.
# This wallet becomes the party HOST — the address sprays accumulate for, shown
# on both surfaces, and the only address that can withdraw().
PRIVATE_KEY=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Name of the party created at deploy. Max 31 chars (stored as bytes32).
PARTY_NAME=Monad Blitz Abuja

# Wallet that receives everything sprayed at the party created at deploy time.
# Optional — defaults to the deployer. In the real flow the person being
# sprayed submits their own address on the landing page and /api/create-party
# opens a party for them, so this is only for having one ready before the event.
PARTY_RECIPIENT=

# --- App --------------------------------------------------------------------
# Public origin, used to build the join QR on /stage. Without this the QR
# encodes localhost and nobody in the room can scan it.
NEXT_PUBLIC_APP_URL=http://localhost:3000
