# ---------------------------------------------------------------------------
# Tap — environment
# Copy to .env.local for the app, and .env for Foundry scripts.
# ---------------------------------------------------------------------------

# --- Chain ------------------------------------------------------------------
# Chain 10143, Monad testnet. These have defaults in lib/rpc.ts; set them only
# to override.

# Dedicated RPC key. STRONGLY recommended — Alchemy, QuickNode and thirdweb all
# offer a free Monad testnet key. When set, every client is assigned here and
# the public endpoints become failover only.
NEXT_PUBLIC_RPC_PRIMARY=
# Optional websocket for the dedicated key (used by the live wall).
NEXT_PUBLIC_RPC_PRIMARY_WS=

# --- Contract ---------------------------------------------------------------
# Written by `npm run deploy`. Never hardcode this in source.
NEXT_PUBLIC_ARENA_CONTRACT=

# --- House wallet (server only — never exposed to the client) ---------------
# Private key of the wallet that funds burners and settles claims. MUST be
# funded in advance: faucet.monad.xyz drips small amounts per day and cannot
# fill this on demand. See README "Faucet economics" for how much you need.
HOUSE_PRIVATE_KEY=

# --- Durable rate limiting (required in production) -------------------------
# Upstash Redis, REST flavour. Without these the faucet FAILS CLOSED in
# production, because in-process limits reset on every serverless cold start
# and are per-instance — they are not rate limits, they are the appearance of
# rate limits. In development they may be left unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Proof of humanity (required in production) -----------------------------
# Cloudflare Turnstile. Gates the claim route only; tapping is never gated.
# Without the secret the faucet FAILS CLOSED in production. Both halves needed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Deploy (Foundry) -------------------------------------------------------
# Deployer key. Becomes the contract OWNER — the address that can move the
# operator or sweep a forced balance. Can be the same as HOUSE_PRIVATE_KEY,
# but should not be: the key sitting in a serverless environment variable
# should not also be the key that can hand ownership away.
PRIVATE_KEY=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Address allowed to call settleClaim — the house server's wallet. This is the
# address of HOUSE_PRIVATE_KEY. Defaults to the deployer if unset.
OPERATOR_ADDRESS=

# --- App --------------------------------------------------------------------
# Public origin, used for og:image and link previews.
NEXT_PUBLIC_APP_URL=http://localhost:3000
